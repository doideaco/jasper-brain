{
  "name": "@jasper-brain/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/handler.js",
  "types": "./dist/handler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/handler.d.ts",
      "default": "./dist/handler.js"
    },
    "./local": "./dist/local.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/local.js",
    "dev": "tsx src/local.ts"
  },
  "dependencies": {
    "@jasper-brain/core": "*",
    "@jasper-brain/mcp": "*",
    "@jasper-brain/store-postgres": "*",
    "@modelcontextprotocol/sdk": "^1.0.4"
  }
}
